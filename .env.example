# Copier ce fichier en .env et l'adapter. Toutes les valeurs sont facultatives.

# Nom du jeu par défaut (modifiable ensuite dans Organisation › Personnalisation)
NOM_JEU=Les As de Salon

# Compte organisateur créé au premier démarrage.
# Sans ADMIN_MOT_DE_PASSE, un mot de passe provisoire est généré et affiché dans la console du serveur.
# Dans tous les cas, il faudra le changer à la première connexion.
ADMIN_IDENTIFIANT=admin
# ADMIN_MOT_DE_PASSE=

# Valeurs de départ de la campagne. Elles se modifient ensuite dans Organisation > Paramètres
# (les réglages enregistrés depuis le site priment sur ce fichier).
PROMO=Promo 2026
SEUIL_SIGNALEMENTS=3
# Dates au format ISO avec fuseau horaire. Sans dates, la campagne est ouverte en permanence.
# CAMPAGNE_DEBUT=2026-11-02T08:00:00+01:00
# CAMPAGNE_FIN=2026-11-09T20:00:00+01:00

# Serveur
PORT=3000
DB_PATH=data/as-de-salon.sqlite

# En production derrière un proxy HTTPS (Render, Railway, Nginx…) :
# NODE_ENV=production
# TRUST_PROXY=1
