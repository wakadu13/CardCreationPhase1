# Copier ce fichier en .env et l'adapter. Toutes les valeurs sont facultatives.

# Nom affiché du jeu et de la promo (la promo apparaît en bas de chaque carte)
NOM_JEU=Les As de Salon
PROMO=Promo 2026

# Dates de la campagne de création (1 semaine). Format ISO avec fuseau horaire.
# Sans dates, la campagne est ouverte en permanence. Exemple pour une semaine :
# CAMPAGNE_DEBUT=2026-11-02T08:00:00+01:00
# CAMPAGNE_FIN=2026-11-09T20:00:00+01:00

# Nombre de signalements (de personnes différentes) qui masquent une carte automatiquement
SEUIL_SIGNALEMENTS=3

# Code à donner à la promo pour pouvoir s'inscrire (vide = inscription libre)
CODE_ACCES=

# Identifiants des organisateurs (séparés par des virgules) : accès à la page Organisation
ADMINS=

# Serveur
PORT=3000
DB_PATH=data/as-de-salon.sqlite

# En production derrière un proxy HTTPS (Render, Railway, Nginx…) :
# NODE_ENV=production
# TRUST_PROXY=1
